{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::<aws-account-number>:oidc-provider/<oidc-provider-id>"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "oidc.op1.openshiftapps.com/2q3ltlp6g55q7kcnbkuunis3p5jjl5o2:sub": "system:serviceaccount:eso-test:my-serviceaccount"
                }
            }
        }
    ]
}